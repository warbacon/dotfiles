// This configuration is merged with the default vicinae configuration file, which you can obtain by running the `vicinae config default` command.
// Every item defined in this file takes precedence over the values defined in the default config or any other imported file.
//
// You can make manual edits to this file, however you should keep in mind that this file may be written to by vicinae when a configuration change is made through the GUI.
// When that happens, any custom comments or formatting will be lost.
//
// If you want to maintain a configuration file with your own comments and formatting, you should create a separate file and add it to the 'imports' array.
//
// Learn more about configuration at https://docs.vicinae.com/config

{
   "$schema": "https://vicinae.com/schemas/config.json",
   "font": {
      "normal": {
         "family": "Monospace",
         "size": 11
      }
   },
   "theme": {
      "dark": {
         "name": "rose-pine"
      }
   },
   "launcher_window": {
      "layer_shell": {
         "layer": "overlay"
      }
   },
   "fallbacks": [],
   "providers": {
      "applications": {
         "preferences": {
            "defaultAction": "focus",
            "launchPrefix": "app2unit --",
            "paths": [
               "/usr/share/applications"
            ]
         },
         "entrypoints": {
            "avahi-discover": {
               "enabled": false
            },
            "bssh": {
               "enabled": false
            },
            "btop": {
               "enabled": false
            },
            "bvnc": {
               "enabled": false
            },
            "nvim": {
               "enabled": false
            },
            "qv4l2": {
               "enabled": false
            },
            "qvidcap": {
               "enabled": false
            },
            "rofi": {
               "enabled": true
            },
            "vicinae": {
               "enabled": false
            }
         }
      },
      "core": {
         "entrypoints": {
            "keybind-settings": {
               "enabled": false
            },
            "oauth-token-store": {
               "enabled": false
            },
            "open-config-file": {
               "enabled": false
            },
            "open-default-config": {
               "enabled": false
            },
            "report-bug": {
               "enabled": false
            },
            "settings": {
               "enabled": false
            },
            "sponsor": {
               "enabled": false
            }
         }
      },
      "developer": {
         "enabled": false
      },
      "files": {
         "enabled": false
      },
      "manage-shortcuts": {
         "enabled": false
      },
      "power": {
         "entrypoints": {
            "hibernate": {
               "enabled": false
            },
            "lock": {
               "alias": "bloquear"
            },
            "logout": {
               "alias": "cerrar sesión"
            },
            "power-off": {
               "alias": "apagar"
            },
            "reboot": {
               "alias": "reiniciar"
            },
            "sleep": {
               "enabled": false
            },
            "soft-reboot": {
               "alias": "reiniciar"
            },
            "suspend": {
               "alias": "suspernder"
            }
         }
      },
      "raycast-compat": {
         "enabled": false
      },
      "system": {
         "enabled": false
      },
      "wm": {
         "enabled": false
      }
   }
}
export PATH="$HOME/.local/bin:$PATH"
export EDITOR="nvim"
export MANPAGER="nvim +Man!"
export ELECTRON_OZONE_PLATFORM_HINT="auto"
export SKIM_DEFAULT_OPTIONS="--layout=reverse --algo=frizbee"
export SKIM_CTRL_T_COMMAND="fd -H --color=never"
export SKIM_ALT_C_COMMAND="fd -H --color=never --type d"

if [[ -f ~/.bashrc ]]; then
    source ~/.bashrc
fi

# BASIC ------------------------------------------------------------------------
export PATH="$HOME/.local/bin:$PATH"

command_exists() {
    command -v "$1" >/dev/null
}

# STOP IF NON-INTERACTIVE ------------------------------------------------------
[[ $- == *i* ]] || return

# UTILITIES --------------------------------------------------------------------
alias_if_exists() {
    command_exists "$2" && alias "$1=$2"
}

init_cached() {
    local cache_file="${XDG_CACHE_HOME:-$HOME/.cache}/$1"
    local cache_dir="${cache_file%/*}"
    shift 1
    [[ -d "$cache_dir" ]] || mkdir -p "$cache_dir"
    [[ -f "$cache_file" ]] || "$@" >"$cache_file"
    source "$cache_file"
}

# ALIASES ----------------------------------------------------------------------
alias ls='ls -v --color=auto --group-directories-first'
alias ll='ls -lh'
alias la='ls -A'
alias lla='ll -lhA'
alias grep='grep --color=auto'
alias cp="cp -iv"
alias mv="mv -iv"
alias rm="rm -v"
alias_if_exists ff fastfetch
alias_if_exists lg lazygit
alias_if_exists open xdg-open

# OPTIONS ----------------------------------------------------------------------
bind "set completion-ignore-case on"
bind "set show-all-if-ambiguous on"
shopt -s autocd
shopt -s cdspell
shopt -s histappend
export HISTCONTROL=ignoreboth:erasedups

# APPEARANCE -------------------------------------------------------------------
PS1='\[\e[1;36m\]\w\[\e[m\]\$ '

if [[ "$TERM" != "linux" ]]; then
    _add_newline() {
        [[ -z "$_should_add_newline" ]] && _should_add_newline=true || echo
    }
    PROMPT_COMMAND="_add_newline; $PROMPT_COMMAND"
    init_cached "starship/init.sh" starship init --print-full-init bash
fi

init_cached "dircolors" dircolors -b

# FZF --------------------------------------------------------------------------
if command_exists fzf; then
    export FZF_DEFAULT_OPTS='--layout=reverse'
    export FZF_CTRL_T_COMMAND='fd -H --color=never --exclude=".cache"'
    export FZF_ALT_C_COMMAND='fd -H --color=never --type=directory --exclude=".cache"'
    init_cached "fzf.sh" fzf --bash
fi
